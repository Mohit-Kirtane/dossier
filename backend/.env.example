# Google Gemini (https://aistudio.google.com/apikey) - via its OpenAI-compatible endpoint
LLM_API_KEY=
# Optional: a second API key (e.g. a separate free-tier project) to fall back to
# if the primary key errors out - most commonly a daily quota exhaustion.
LLM_API_KEY_FALLBACK=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local embedding model (downloaded once, runs on CPU, no API quota used)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage - defaults to local SQLite + on-disk FAISS for easy local dev.
# For deployment, point DATABASE_URL at a managed Postgres instance, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db
FAISS_INDEX_DIR=./data/faiss_index
UPLOAD_DIR=./data/uploads
POLICY_FAISS_INDEX_DIR=./data/policy_faiss_index
POLICY_UPLOAD_DIR=./data/policy_uploads
MAX_UPLOAD_SIZE_MB=5

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
RELEVANCE_SCORE_THRESHOLD=0.0

# Auth - JWT stored in an httpOnly cookie
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=10080
# Set true once served over HTTPS (e.g. in production) - false for local http://localhost dev
COOKIE_SECURE=false
# Comma-separated emails that get admin access (activity dashboard) on signup/login
ADMIN_EMAILS=

# Google OAuth (https://console.cloud.google.com/apis/credentials) - optional;
# email/password auth works without these. See README for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
